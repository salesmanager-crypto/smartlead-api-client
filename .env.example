# Copy this file to .env and fill in your real key.
# Get your API key from: Smartlead dashboard -> Settings -> API Key
SMARTLEAD_API_KEY=your_api_key_here

# Only override if Smartlead gives you a different regional/base URL.
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1

# Google Drive (optional) — used to upload/organize CSV exports.
# Get Client ID/Secret from Google Cloud Console -> APIs & Services -> Credentials ->
# an OAuth client of type "Web application". Then run `node scripts/google-drive-auth.mjs`
# once to obtain GOOGLE_REFRESH_TOKEN (it prints the line to paste in here).
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/callback
GOOGLE_REFRESH_TOKEN=
