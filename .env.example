# Copy this file to .env and fill in your real key.
# Get your API key from: Smartlead dashboard -> Settings -> API Key
SMARTLEAD_API_KEY=your_api_key_here

# Only override if Smartlead gives you a different regional/base URL.
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1

# Get your key from: https://app.quickemailverification.com -> Settings -> API
QUICKEMAILVERIFICATION_API_KEY=your_qev_api_key_here

# Get your token from: https://portal.premiuminboxes.com/settings -> API Token
# One token covers your whole agency; endpoints that need one workspace also take a
# `workspaceId` (see src/premiuminboxes.js) sent as the x-workspace-id header.
PREMIUM_INBOXES_API_KEY=your_premium_inboxes_api_token_here

# Get both from: https://porkbun.com/account/api -> Create API Key
# Per-domain DNS/nameserver/SSL endpoints also need "API access" enabled for that domain
# (or globally) in Porkbun's account settings, separate from having a key at all.
PORKBUN_API_KEY=your_porkbun_api_key_here
PORKBUN_SECRET_API_KEY=your_porkbun_secret_api_key_here

# Get these from: https://ap.www.namecheap.com/settings/tools/apiaccess
# ApiUser and UserName are usually the same value (your Namecheap login username).
# NAMECHEAP_CLIENT_IP must be whitelisted on that same page (API Access > Whitelisted
# IPs) or every request fails with an IP error regardless of how correct the keys are.
NAMECHEAP_API_USER=your_namecheap_username_here
NAMECHEAP_API_KEY=your_namecheap_api_key_here
NAMECHEAP_USERNAME=your_namecheap_username_here
NAMECHEAP_CLIENT_IP=your_whitelisted_ip_here

# Get from: https://developers.fathom.ai -> API Keys
# fa:meetings only ever returns meetings titled "Albert Scott" in some form —
# see src/fathom.js for why that's structural, not just a filter.
FATHOM_API_KEY=your_fathom_api_key_here

# Get from a Google Cloud service account JSON key (APIs & Services > Credentials >
# your service account > Keys > Add Key > JSON). Share the target sheet with the
# service account's email as an Editor first, or every write fails on permissions.
# Store the private key as one line with literal \n sequences (not real newlines) —
# src/googlesheets.js unescapes them at load time.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# HeyReach has two incompatible key scopes that share the same header — see src/heyreach.js.
# Workspace-level key (inside a workspace: Settings -> API). Needed for campaigns/leads/network.
HEYREACH_API_KEY=your_heyreach_workspace_api_key_here
# Organization-level key (Organization settings, org-admin only). Needed only for hr:workspaces
# and minting new workspace keys — does NOT work on the campaign/lead endpoints above.
HEYREACH_ORG_API_KEY=your_heyreach_organization_api_key_here

# Pipedrive personal API token (Personal preferences -> API). Used by dashboards/pull/pull-pipedrive.mjs
PIPEDRIVE_API_TOKEN=
